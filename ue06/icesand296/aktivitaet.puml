@startuml
skinparam defaultTextAlignment center

|Studentin|
start
:Sprechstunde auswählen;
if (Bereits am Hochschulkonto angemeldet?) then (nein)
  :Anmelden mit Hochschulkonto;
else (ja)
endif

|Terminplaner|
:Freie Zeitfenster der\nSprechstunde anzeigen;

|Studentin|
:Zeitfenster auswählen\nund Anliegen eintragen;

|Terminplaner|
if (Zeitfenster noch frei?) then (nein)
  if (Kein Zeitfenster mehr frei?) then (ja)
    |Terminplaner|
    :Warteliste anbieten;
    |Studentin|
    if (Warteliste annehmen?) then (ja)
      |Terminplaner|
      :Auf die Warteliste setzen;
      stop
    else (nein)
      stop
    endif
  else (nein)
    |Terminplaner|
    :Freie Zeitfenster\nerneut anzeigen;
    detach
  endif
else (ja)
  :Buchung eintragen;
  fork
    :Bestätigung mit\niCal-Datei an\nStudentin schicken;
  fork again
    :Lehrperson\nbenachrichtigen;
  fork again
    :Zeitfenster als\ngebucht vermerken;
  end fork
  :Buchung abgeschlossen;
  stop
endif

@enduml
